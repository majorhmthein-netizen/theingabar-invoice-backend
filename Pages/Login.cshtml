@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}
<div class="panel">
  <h2>Log in</h2>
  <p class="hint">Mechanics log in with their username and password. Log in again on every open — no session is kept.</p>
  <form method="post">
    <label class="fld"><span>Username</span><input name="Username" value="@Model.Username" required maxlength="20" autocomplete="username" /></label>
    <label class="fld"><span>Password</span><input name="Password" type="password" required autocomplete="current-password" /></label>
    @if (Model.Error is not null)
    {
      <p class="field-error">@Model.Error</p>
    }
    <button class="btn" type="submit">Log in</button>
  </form>
  <p class="hint">No account yet? <a href="/signup">Sign up</a> — the Admin approves new mechanics.</p>
</div>
