@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}
<div class="panel">
  <h2>Log in</h2>
  <p class="hint">Mechanics log in with their phone and their 4-digit PIN. You stay logged in until you tap Log out.</p>
  <form method="post" id="request-form">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <label class="fld"><span>Phone</span><input name="Phone" value="@Model.Phone" required inputmode="tel" autocomplete="tel" placeholder="09…" /></label>
    <label class="fld"><span>4-digit PIN</span><input name="Pin" type="password" required inputmode="numeric" autocomplete="current-password" maxlength="4" placeholder="••••" /></label>
    @if (Model.LockoutSeconds > 0)
    {
      <p class="field-error" id="lockout-error">Too many attempts — try again in <span id="lockout-countdown" data-seconds="@Model.LockoutSeconds">@Model.LockoutText</span>.</p>
    }
    else if (Model.Error is not null)
    {
      <p class="field-error">@Model.Error</p>
    }
    <button class="btn" type="submit" id="login-btn" @(Model.LockoutSeconds > 0 ? "disabled" : "")>Log in</button>
  </form>
  <script src="/js/login-loading.js" defer></script>
  @if (Model.LockoutSeconds > 0)
  {
    <script src="/js/countdown.js" defer></script>
  }
  <p class="hint">No account yet? <a href="/signup">Sign up</a> — approval is needed before you can issue invoices.</p>
</div>
