@page
@model UserProfilePicModel
@{
    ViewData["Title"] = "Profile picture";
}
@section Scripts {
  <script src="/js/cropper.js"></script>
}
<div class="panel panel-fill">
  <h2>Profile picture</h2>
  <p class="hint">Your photo, shown next to your name. Pick a photo, then save. You can change it any time.</p>
  <div class="scroll">
  <form method="post" enctype="multipart/form-data">
    <label class="fld"><span>Photo (JPG/PNG, max 2 MB)</span><input id="avatar-file" name="AvatarFile" type="file" accept="image/jpeg,image/png,image/webp" data-out="128" data-thumb="avatar-thumb" /></label>
    @if (Model.HasAvatar)
    {
      <p><span class="hint">Current picture</span><br /><img id="avatar-thumb" class="profile-avatar" src="/avatar/user/@Model.UserId" alt="Current profile picture" /></p>
    }
    else
    {
      <p><img id="avatar-thumb" class="profile-avatar" src="" alt="" hidden /></p>
    }
    <button class="btn" type="submit">Save picture</button>
  </form>
  </div>
</div>
