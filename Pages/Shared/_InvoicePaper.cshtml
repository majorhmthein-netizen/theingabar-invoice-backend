@* Invoice paper — the APPROVED Safari template layout (Han 2026-11-21):
   two-column letterhead (gold logo left, INVOICE + id right),
   boxed customer panel, navy items-table header, QR code below the
   table, thanks + group line. Han-ordered changes vs the template:
   title is the gold logo (trial 2026-11-21, was U Moe text) and both
   "Theingabar Automotive Group" lines are gold; signatures removed
   (2026-11-21); payment box removed, QR alone (2026-11-21); the
   "No." column header is blank so it never reads as "no description"
   (row numbers 1,2,3… stay); "Currency: MMK" removed from the customer
   box (the AMOUNT (MMK) header + Total (MMK) below already show it).
   Do not change the layout otherwise: the printed invoice format
   stays exactly as approved. Model: InvoicePaperModel. Razor
   auto-encodes all values. *@
@* Paper size (Han 2026-11-21): A4 (full page) is the default; a
   half-A4 invoice prints on A5 instead. @page cannot be scoped to a
   class, so the half-A4 page is declared here, after invoice.css,
   so it wins for this invoice only. *@
@if (Model.IsHalf)
{
  <style>@("@page{size:A5;margin:6mm}")</style>
}
@model InvoicePaperModel
@{
    var tier = Paper.ItemTier(Model.Items.Count);
    var tierCls = tier == 2 ? " inv-n16" : tier == 1 ? " inv-n11" : "";
    var cls = "invoice" + tierCls + Paper.CompactClass(Model.Items.Count);
}
<div class="@cls" id="invoice">
  <div class="inv-letterhead">
    <div class="inv-brand">
      <div class="inv-brand-left">
        <img class="inv-logo" id="pShop" src="/img/theingabar-logo-header.jpg" alt="သိန်းကမ္ဘာ" />
        <div class="inv-group" id="pGroup">@Model.Meta.Group</div>
      </div>
      <div class="inv-brand-right">
        <div class="inv-word">INVOICE</div>
        <div class="inv-no"><span class="lbl">id:</span> @Model.No</div>
      </div>
    </div>
    <div class="inv-services" id="pServices">@Model.Meta.Services</div>
    <div class="inv-addr">
      <span><b>Address:</b> <span id="pAddress">@Model.Meta.Address</span></span>
      <span><b>Contact:</b> <span id="pPhones">@Model.Meta.PhonesDisplay</span></span>
    </div>
  </div>
  <div class="inv-custbox">
    <div class="inv-cust">
      <span class="k">Customer / Vehicle</span>
      <span class="v" id="pCustomer">@(string.IsNullOrWhiteSpace(Model.Customer) ? "—" : Model.Customer)</span>
    </div>
    <div class="inv-custdate">
      <span class="k">Date</span>
      <span class="v" id="pDate">@Paper.FmtDate(Model.Date)</span>
    </div>
  </div>
  <div class="inv-table-wrap">
  <div class="inv-watermark" aria-hidden="true">
    <img src="/img/theingabar-logo-watermark.jpg" alt="" />
    @* The logo already carries the gold သိန်းကမ္ဘာ wordmark, so no
       separate shop-name text line (it duplicated it — Han 2026-11-21).
       Group + id sit right under the gold logo, in the shop gold. *@
    <span class="wm-group">@Model.Meta.Group</span>
    <span class="wm-id">id: @Model.No</span>
  </div>
  <table class="inv-table">
    <thead>
      <tr><th style="width:28px"></th><th>Description</th><th class="amt">Amount (MMK)</th></tr>
    </thead>
    <tbody id="pItems">
    @for (var i = 0; i < Model.Items.Count; i++)
    {
      var it = Model.Items[i];
      <tr><td class="no">@(i + 1)</td><td class="desc">@(string.IsNullOrWhiteSpace(it.Desc) ? "—" : it.Desc)</td><td class="amt">@Paper.Fmt(it.Amount)</td></tr>
    }
    </tbody>
    <tbody>
      <tr class="inv-total"><td></td><td>Total (MMK)</td><td class="amt" id="pTotal">@Paper.Fmt(Model.Total)</td></tr>
      @if (Model.Deposit > 0)
      {
        <tr class="inv-deposit"><td></td><td>Deposit (စရံငွေ)</td><td class="amt" id="pDeposit">@Paper.Fmt(Model.Deposit)</td></tr>
        <tr class="inv-final"><td></td><td>Final Total (MMK)</td><td class="amt" id="pFinalTotal">@Paper.Fmt(Model.FinalTotal)</td></tr>
      }
    </tbody>
  </table>
  </div>
  @* Payment box removed (Han 2026-11-21) — only the QR stays, centred
     under the table, so the space is cleaner. *@
  <div class="inv-qr">
    <img id="pQr" class="p-qr" data-cache="@Model.QrCacheKey" src="@Model.QrSrc" alt="KBZ Pay QR code for @Model.PayName, @Model.PayNum" crossorigin="anonymous" />
  </div>
  <div class="inv-thanks">
    <span class="en" id="pThanks">@Model.Meta.Thanks</span>
    <span class="inv-thanks-group">@Paper.TitleCase(Model.Meta.Group)</span>
  </div>
</div>
