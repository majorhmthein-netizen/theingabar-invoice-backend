@* Invoice paper — the APPROVED Safari template layout (Han 2026-11-21):
   two-column letterhead (gold logo left, INVOICE + id right),
   boxed customer panel, navy items-table header, boxed payment panel,
   two signature lines, thanks + group line. Han-ordered changes vs
   the template: title is the gold logo (trial 2026-11-21, was U Moe text)
   and both "Theingabar Automotive Group" lines are gold. Do not change
   the layout otherwise: the printed invoice format stays exactly as
   approved. Model: InvoicePaperModel. Razor auto-encodes all values. *@
@model InvoicePaperModel
<div class="invoice@(Paper.ItemTier(Model.Items.Count) == 2 ? " inv-n16" : Paper.ItemTier(Model.Items.Count) == 1 ? " inv-n11" : "")" id="invoice">
  <div class="inv-letterhead">
    <div class="inv-brand">
      <div class="inv-brand-left">
        <img class="inv-logo" id="pShop" src="/img/theingabar-logo-header.jpg" alt="သိန်းကမ္ဘာ" />
        <div class="inv-group" id="pGroup">@Model.Meta.Group</div>
      </div>
      <div class="inv-brand-right">
        <div class="inv-word">INVOICE</div>
        <div class="inv-no"><span class="lbl">id:</span> @Model.No</div>
      </div>
    </div>
    <div class="inv-services" id="pServices">@Model.Meta.Services</div>
    <div class="inv-addr">
      <span><b>Address:</b> <span id="pAddress">@Model.Meta.Address</span></span>
      <span><b>Contact:</b> <span id="pPhones">@Model.Meta.PhonesDisplay</span></span>
    </div>
  </div>
  <div class="inv-custbox">
    <div class="inv-cust">
      <span class="k">Customer / Vehicle</span>
      <span class="v" id="pCustomer">@(string.IsNullOrWhiteSpace(Model.Customer) ? "—" : Model.Customer)</span>
    </div>
    <div class="inv-custdate">
      <span class="k">Date</span>
      <span class="v" id="pDate">@Paper.FmtDate(Model.Date)</span>
      <span class="inv-curr">Currency: MMK</span>
    </div>
  </div>
  <div class="inv-table-wrap">
  <img class="inv-watermark" src="/img/theingabar-logo-watermark.jpg" alt="" aria-hidden="true" />
  <table class="inv-table">
    <thead>
      <tr><th style="width:28px">No.</th><th>Description</th><th class="amt">Amount (MMK)</th></tr>
    </thead>
    <tbody id="pItems">
    @for (var i = 0; i < Model.Items.Count; i++)
    {
      var it = Model.Items[i];
      <tr><td class="no">@(i + 1)</td><td class="desc">@(string.IsNullOrWhiteSpace(it.Desc) ? "—" : it.Desc)</td><td class="amt">@Paper.Fmt(it.Amount)</td></tr>
    }
    </tbody>
    <tbody>
      <tr class="inv-total"><td></td><td>Total (MMK)</td><td class="amt" id="pTotal">@Paper.Fmt(Model.Total)</td></tr>
    </tbody>
  </table>
  </div>
  <div class="inv-paybox">
    <div class="inv-paytext">
      <div class="p-k">Payment</div>
      <div class="p-line"><b class="p-name">KBZ Pay</b> — No. <b class="p-num" id="pPayNum">@Model.PayNum</b> — Name: <b class="p-payname" id="pPayName">@Model.PayName</b></div>
      <div class="p-scan">Scan the QR code with KBZPay to pay.</div>
    </div>
    <img id="pQr" class="p-qr" src="@Model.QrSrc" alt="KBZ Pay QR code for @Model.PayName, @Model.PayNum" crossorigin="anonymous" />
  </div>
  <div class="inv-sign">
    <div class="sign-box"><div class="line"></div><div class="cap">Customer Signature</div></div>
    <div class="sign-box"><div class="line"></div><div class="cap">Authorized Signature</div></div>
  </div>
  <div class="inv-thanks">
    <span class="en" id="pThanks">@Model.Meta.Thanks</span>
    <span class="inv-thanks-group">@Paper.TitleCase(Model.Meta.Group)</span>
  </div>
</div>
