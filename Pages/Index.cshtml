@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<div class="scroll boxes">
<div class="panel">
  <h2 class="shop-title">@Model.Meta?.Shop</h2>
  <p class="hint">@Model.Meta?.Group<br />@Model.Meta?.Services<br />@Model.Meta?.Address — @Model.Meta?.PhonesDisplay</p>
</div>

<div class="panel">
  <h2>Mechanics</h2>
  @if (Model.Users.Count == 0)
  {
    <p class="hint">No mechanics yet.</p>
  }
  @foreach (var u in Model.Users)
  {
    <span class="user-chip"><span class="avatar">@Paper_Initials(u.Username)</span>@u.Username</span>
  }
</div>

<div class="panel">
  <h2>Income</h2>
  @* This month taps through to this month's log (Han 2026-11-21).
     This week is gone; Recent invoices is gone. *@
  <div class="log-row" data-href="/month/@Model.MonthYm">
    <span><b>This month</b></span>
    <span class="amt">@Paper.Fmt(Model.MonthTotal) MMK</span>
  </div>
</div>
</div>

<div class="panel panel-fill">
  <h2>Previous months</h2>
  <div class="scroll">
  @if (Model.Months.Count == 0)
  {
    <p class="hint">No earlier months yet.</p>
  }
  @foreach (var m in Model.Months)
  {
    <div class="log-row" data-href="/month/@m.Ym">
      <span class="log-no">@m.Label</span>
      <span>@m.Count @(m.Count == 1 ? "invoice" : "invoices")</span>
      <span class="amt">@Paper.Fmt(m.Total) MMK</span>
    </div>
  }
  </div>
</div>

@functions {
    static string Paper_Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(1, parts[0].Length)];
        return string.Concat(parts[0][..1], parts[1][..1]);
    }
}
