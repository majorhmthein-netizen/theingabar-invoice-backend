@page
@model UserModel
@{
    ViewData["Title"] = "User";
}
<div class="scroll">
<div class="panel">
  @if (Model.User!.HasAvatar)
  {
    <p><img class="profile-avatar" data-cache="tgb-avatar-@Model.User.Id" src="/avatar/user/@Model.User.Id" alt="@Model.User.Username" /></p>
  }
  <h2>@Model.User!.Username</h2>
  <p>Phone: @Model.User.Phone<br />Status: <b>@Model.User.Status</b></p>
  @if (!Model.CanWrite)
  {
    <p class="flash">pending</p>
  }
</div>

<div class="panel">
  <h2>Profile</h2>
  <p><a class="btn menu-btn" href="/User/ProfilePic">Profile picture</a></p>
  <p><a class="btn menu-btn" href="/User/ChangePin">Change PIN</a></p>
  <p><a class="btn menu-btn" href="/User/MyQr">My QR</a></p>
  @if (Model.CanWrite)
  {
    <p><a class="btn gold menu-btn" href="/form">New invoice</a></p>
  }
  <p><a class="btn ghost menu-btn" href="/logout">Log out</a></p>
</div>
</div>
